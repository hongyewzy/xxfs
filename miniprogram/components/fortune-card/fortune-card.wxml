<!-- components/fortune-card/fortune-card.wxml -->
<view class="fortune-card">
  <!-- 顶部彩色标签区域 -->
  <view class="card-tags" wx:if="{{card.tags && card.tags.length > 0}}">
    <view
      class="tag-item {{item.type}}"
      wx:for="{{card.tags}}"
      wx:key="index"
      bindtap="onTagTap"
      data-type="{{item.type}}"
      data-name="{{item.name}}"
    >
      {{item.name}}
    </view>
  </view>

  <!-- 卡片头部 -->
  <view class="card-header">
    <text class="card-title">{{card.title}}</text>
    <!-- 金色渐变进度条装饰 -->
    <view class="gold-progress"></view>
  </view>

  <!-- 副标题区：左侧小标题 + 右侧状态文字 -->
  <view class="card-subtitle-wrap" wx:if="{{card.subtitle || card.status}}">
    <text class="subtitle-text" wx:if="{{card.subtitle}}">{{card.subtitle}}</text>
    <text
      class="status-text"
      wx:if="{{card.status}}"
      style="color: {{card.status.color || '#666'}};"
    >{{card.status.text}}</text>
  </view>

  <!-- 正文内容 -->
  <view class="card-content {{isExpanded ? 'expanded' : 'collapsed'}}">
    <rich-text class="content-text" nodes="{{card.content}}"></rich-text>
  </view>

  <!-- 展开/收起链接 -->
  <view
    class="expand-link"
    wx:if="{{card.content && card.maxLines}}"
    bindtap="toggleExpand"
  >
    <text wx:if="{{!isExpanded}}">...全文</text>
    <text wx:else>收起</text>
  </view>

  <!-- 底部信息栏 -->
  <view
    class="card-footer"
    wx:if="{{card.footer}}"
    bindtap="onFooterTap"
  >
    <view class="footer-left">
      <text wx:if="{{card.footer.icon}}" class="footer-icon-text">{{card.footer.icon}}</text>
      <text class="footer-text">{{card.footer.text}}</text>
    </view>
    <view class="footer-right" wx:if="{{card.footer.count !== undefined}}">
      <text class="footer-count">{{card.footer.count}}{{card.footer.action || '人讨论'}}</text>
      <text class="footer-arrow"> ></text>
    </view>
  </view>
</view>
