<!-- components/loading-progress/loading-progress.wxml -->
<view class="loading-progress" wx:if="{{show}}">
  <view class="progress-content">
    <view class="progress-icon">
      <text class="icon-text">{{icon}}</text>
    </view>
    <view class="progress-bar-wrap">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{percent}}%;"></view>
      </view>
      <text class="progress-text">{{text}}</text>
      <text class="progress-hint" wx:if="{{showHint}}">正在推算天机，请耐心等待...</text>
    </view>
  </view>
</view>