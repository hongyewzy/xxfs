/* components/loading-progress/loading-progress.wxss */

.loading-progress {
  margin-top: 20rpx;
}

.progress-content {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(184, 150, 46, 0.15);
  border: 2rpx solid rgba(184, 150, 46, 0.2);
}

.progress-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #B8962E, #D4A84B);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 1.5s ease-in-out infinite;
}

.icon-text {
  font-size: 32rpx;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.progress-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-bar {
  height: 10rpx;
  background: #F0F0F0;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #B8962E, #D4A84B, #F0D878);
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 26rpx;
  color: #666;
  letter-spacing: 1rpx;
}

.progress-hint {
  font-size: 22rpx;
  color: #B8962E;
  letter-spacing: 1rpx;
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}