/* components/loading-progress/loading-progress.wxss */

.loading-progress {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.progress-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-content {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 64rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  min-width: 480rpx;
}

.progress-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #B8962E, #D4A84B);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 1.5s ease-in-out infinite;
}

.icon-text {
  font-size: 40rpx;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.progress-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.progress-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #B8962E, #D4A84B, #F0D878);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 26rpx;
  color: #666;
  letter-spacing: 1rpx;
}