/* pages/bazi/bazi.wxss - 晨光星河天机阁风格 */
.container {
  padding-bottom: 120rpx;
}

.section-title {
  font-size: 36rpx;
  color: var(--gold-primary);
  text-align: center;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.calendar-type {
  padding: 20rpx 0;
}

.calendar-type .label {
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.type-switch {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-light);
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  transition: all 0.3s;
}

.switch-item.active {
  background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
  color: #ffffff;
  font-weight: 600;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.block {
  display: block;
}

/* 八字展示 */
.bazi-display {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 10rpx;
  gap: 16rpx;
}

.bazi-pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid var(--border-gold);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  flex: 1;
  min-width: 0;
}

.bazi-pillar .gan {
  font-size: 48rpx;
  color: var(--gold-primary);
  font-weight: 600;
  line-height: 1.2;
}

.bazi-pillar .zhi {
  font-size: 48rpx;
  color: var(--text-primary);
  font-weight: 600;
  line-height: 1.2;
}

.bazi-pillar .label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}

/* 五行统计 */
.wuxing-display {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  gap: 24rpx;
  flex-wrap: wrap;
}

.wuxing-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.wuxing-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.wuxing-circle.jin { background: var(--wuxing-gold); }
.wuxing-circle.mu { background: var(--wuxing-wood); }
.wuxing-circle.shui { background: var(--wuxing-water); }
.wuxing-circle.huo { background: var(--wuxing-fire); }
.wuxing-circle.tu { background: var(--wuxing-earth); }

.wuxing-item .count {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

/* AI 结果 */
.ai-result {
  padding: 30rpx 0;
  line-height: 1.8;
}

.result-text {
  color: var(--text-primary);
  font-size: 28rpx;
  white-space: pre-wrap;
}

/* 输入选择器 */
.picker-field {
  background: #ffffff;
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s;
}

.picker-field:active {
  border-color: var(--gold-primary);
}

.picker-field .value {
  color: var(--text-primary);
  font-size: 28rpx;
}

.picker-field .placeholder {
  color: var(--text-muted);
  font-size: 28rpx;
}

.picker-field .arrow {
  color: var(--gold-primary);
  font-size: 24rpx;
}

/* 四柱/五行解释样式 */
.pillar-explain,
.wuxing-explain {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 0;
}

.explain-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
}

.explain-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #B8962E;
  width: 100rpx;
  flex-shrink: 0;
}

.explain-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  flex: 1;
}

.wuxing-tag {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFF;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.wuxing-tag.jin { background: linear-gradient(135deg, #D4A84B, #B8962E); }
.wuxing-tag.mu { background: linear-gradient(135deg, #34D399, #10B981); }
.wuxing-tag.shui { background: linear-gradient(135deg, #60A5FA, #3B82F6); }
.wuxing-tag.huo { background: linear-gradient(135deg, #F87171, #EF4444); }
.wuxing-tag.tu { background: linear-gradient(135deg, #FBBF24, #F59E0B); }
