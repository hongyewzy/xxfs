/* pages/bazi/bazi.wxss - 晨光星河天机阁风格 */
.container {
  padding-bottom: 120rpx;
}

.section-title {
  font-size: 36rpx;
  color: var(--gold-primary);
  text-align: center;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.calendar-type {
  padding: 20rpx 0;
}

.calendar-type .label {
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.type-switch {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-light);
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  transition: all 0.3s;
}

.switch-item.active {
  background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
  color: #ffffff;
  font-weight: 600;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.block {
  display: block;
}

/* 八字展示 */
.bazi-display {
  padding: 30rpx 0;
}

.bazi-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.bazi-pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid var(--border-gold);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  min-width: 140rpx;
}

.bazi-pillar .gan {
  font-size: 56rpx;
  color: var(--gold-primary);
  font-weight: 600;
  line-height: 1.2;
}

.bazi-pillar .zhi {
  font-size: 56rpx;
  color: var(--text-primary);
  font-weight: 600;
  line-height: 1.2;
}

.bazi-pillar .label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* 五行统计 */
.wuxing-display {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  gap: 24rpx;
  flex-wrap: wrap;
}

.wuxing-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.wuxing-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.wuxing-circle.jin { background: var(--wuxing-gold); }
.wuxing-circle.mu { background: var(--wuxing-wood); }
.wuxing-circle.shui { background: var(--wuxing-water); }
.wuxing-circle.huo { background: var(--wuxing-fire); }
.wuxing-circle.tu { background: var(--wuxing-earth); }

.wuxing-item .count {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

/* AI 结果 */
.ai-result {
  padding: 30rpx 0;
  line-height: 1.8;
}

.result-text {
  color: var(--text-primary);
  font-size: 28rpx;
  white-space: pre-wrap;
}

/* 输入选择器 */
.picker-field {
  background: #ffffff;
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s;
}

.picker-field:active {
  border-color: var(--gold-primary);
}

.picker-field .value {
  color: var(--text-primary);
  font-size: 28rpx;
}

.picker-field .placeholder {
  color: var(--text-muted);
  font-size: 28rpx;
}

.picker-field .arrow {
  color: var(--gold-primary);
  font-size: 24rpx;
}
