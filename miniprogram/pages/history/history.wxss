/* pages/history/history.wxss - 晨光星河天机阁风格 */
.container {
  padding-bottom: 120rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  padding: 24rpx 30rpx;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid var(--border-light);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  transition: all 0.3s ease;
}

.filter-item.active {
  background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(184, 150, 46, 0.25);
}

.history-list {
  padding-bottom: 100rpx;
}

/* 历史记录卡片 */
.history-item {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid var(--border-light);
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 左侧金色条 */
.history-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--gold-gradient);
}

.item-content {
  padding: 28rpx 28rpx 28rpx 36rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.item-time {
  font-size: 24rpx;
  color: var(--text-muted);
}

.item-type {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(74, 124, 180, 0.1);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--blue-primary);
  margin-bottom: 16rpx;
}

.item-result {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.02);
  border-radius: 12rpx;
}

.item-actions {
  display: flex;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.action-btn {
  font-size: 26rpx;
  color: var(--gold-primary);
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.action-btn:active {
  background: rgba(184, 150, 46, 0.08);
}

.action-btn.delete {
  color: #ef4444;
}

.action-btn.delete:active {
  background: rgba(239, 68, 68, 0.08);
}

/* 空状态 */
.empty-state {
  padding: 160rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.2;
  margin-bottom: 24rpx;
}

.empty-text {
  color: var(--text-muted);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
