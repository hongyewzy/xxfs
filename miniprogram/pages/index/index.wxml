<!--pages/index/index.wxml-->
<star-sky />
<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <view class="logo-container">
      <text class="logo-text">天机阁</text>
      <text class="logo-subtitle">中华传统文化 · 古今智慧传承</text>
    </view>
  </view>

  <!-- 每日运势卡片 -->
  <view class="style-card gold">
    <view class="style-card-content">
      <view class="fortune-header">
        <text class="style-card-title">今日参考</text>
        <view class="fortune-switch">
          <view class="switch-item {{fortuneType === 'zodiac' ? 'active' : ''}}" bindtap="switchFortuneType" data-type="zodiac">星座</view>
          <view class="switch-item {{fortuneType === 'shengxiao' ? 'active' : ''}}" bindtap="switchFortuneType" data-type="shengxiao">生肖</view>
        </view>
      </view>

      <!-- 星座选择 -->
      <picker mode="selector" range="{{zodiacSigns}}" value="{{zodiacIndex}}" bindchange="onZodiacChange" wx:if="{{fortuneType === 'zodiac'}}">
        <view class="fortune-picker">
          <text class="picker-value">{{zodiacSigns[zodiacIndex]}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>

      <!-- 生肖选择 -->
      <picker mode="selector" range="{{shengxiaoList}}" value="{{shengxiaoIndex}}" bindchange="onShengxiaoChange" wx:if="{{fortuneType === 'shengxiao'}}">
        <view class="fortune-picker">
          <text class="picker-value">{{shengxiaoList[shengxiaoIndex]}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>

      <!-- 运势展示 -->
      <view class="fortune-result" wx:if="{{fortune}}">
        <view class="fortune-level level-{{fortune.levelIndex}}">{{fortune.level}}</view>
        <view class="fortune-detail">
          <view class="detail-item">
            <text class="detail-label">幸运色</text>
            <text class="detail-value">{{fortune.luckyColor}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">幸运数字</text>
            <text class="detail-value">{{fortune.luckyNumber}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">宜</text>
            <text class="detail-value good">{{fortune.good}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">忌</text>
            <text class="detail-value bad">{{fortune.bad}}</text>
          </view>
        </view>
        <view class="fortune-comment">{{fortune.comment}}</view>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section">
    <view class="section-title">传统文化</view>
    <view class="function-grid">
      <view class="function-item" bindtap="navigateTo" data-url="/pages/bazi/bazi">
        <view class="icon bazi-icon">柱</view>
        <text class="name">四柱文化</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-url="/packageTarot/pages/tarot/tarot">
        <view class="icon tarot-icon">牌</view>
        <text class="name">塔罗文化</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-url="/pages/meihua/meihua">
        <view class="icon meihua-icon">卦</view>
        <text class="name">易学文化</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-url="/pages/dream/dream">
        <view class="icon dream-icon">析</view>
        <text class="name">梦境解析</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-url="/pages/name/name">
        <view class="icon name-icon">名</view>
        <text class="name">姓名文化</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-url="/pages/naming/naming">
        <view class="icon naming-icon">取</view>
        <text class="name">取名参考</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-url="/pages/lunar/lunar">
        <view class="icon lunar-icon">历</view>
        <text class="name">农历查询</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-url="/pages/history/history">
        <view class="icon history-icon">史</view>
        <text class="name">历史记录</text>
      </view>
    </view>
  </view>

  <!-- 底部说明 -->
  <view class="footer">
    <text class="footer-text">传统文化学习工具，仅供文化研究参考</text>
  </view>
</view>
