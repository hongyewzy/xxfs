/* pages/tarot/tarot.wxss */
.input-area {
  width: 100%;
  min-height: 150rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--border-gold);
  border-radius: 12rpx;
  padding: 24rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  box-sizing: border-box;
}

.spread-list {
  display: flex;
  gap: 20rpx;
}

.spread-item {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--border-gold);
  border-radius: 12rpx;
  text-align: center;
  transition: all 0.3s;
}

.spread-item.active {
  background: rgba(212, 175, 55, 0.15);
  border-color: var(--gold-primary);
}

.spread-name {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.spread-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.tarot-cards {
  gap: 30rpx;
  padding: 30rpx 0;
}

.tarot-card-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tarot-card {
  width: 180rpx;
  height: 280rpx;
  perspective: 1000rpx;
  position: relative;
  animation: fadeInUp 0.5s ease forwards;
  opacity: 0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tarot-card-front,
.tarot-card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--gold-primary);
  transition: transform 0.6s;
}

.tarot-card-back {
  background: linear-gradient(145deg, #2a2a2a 0%, #1a1a1a 100%);
}

.card-symbol {
  font-size: 60rpx;
  color: var(--gold-primary);
}

.tarot-card-front {
  background: linear-gradient(145deg, #1f1f1f 0%, #151515 100%);
  transform: rotateY(180deg);
}

.tarot-card.flipped .tarot-card-back {
  transform: rotateY(180deg);
}

.tarot-card.flipped .tarot-card-front {
  transform: rotateY(0deg);
}

.card-name {
  font-size: 28rpx;
  color: var(--gold-primary);
  text-align: center;
  padding: 0 16rpx;
}

.card-position {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
}

.card-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 16rpx;
}

.result-text {
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
