/* pages/naming/naming.wxss */
.count-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--border-gold);
  border-radius: 8rpx;
  margin-right: 20rpx;
  color: var(--text-muted);
  transition: all 0.3s;
}

.count-option:last-child {
  margin-right: 0;
}

.count-option.active {
  background: rgba(212, 175, 55, 0.15);
  border-color: var(--gold-primary);
  color: var(--gold-primary);
}

.name-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--border-gold);
  border-radius: 12rpx;
}

.name-text {
  font-size: 36rpx;
  color: var(--gold-primary);
  font-weight: 600;
  margin-right: 20rpx;
}

.name-desc {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-muted);
}

.name-score {
  font-size: 28rpx;
  color: var(--text-secondary);
  background: rgba(212, 175, 55, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.result-text {
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
