/* pages/naming/naming.wxss */
.count-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--border-gold);
  border-radius: 8rpx;
  margin-right: 20rpx;
  color: var(--text-muted);
  transition: all 0.3s;
}

.count-option:last-child {
  margin-right: 0;
}

.count-option.active {
  background: rgba(212, 175, 55, 0.15);
  border-color: var(--gold-primary);
  color: var(--gold-primary);
}

.name-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.name-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--border-gold);
  border-radius: 12rpx;
  transition: all 0.3s;
}

.name-item:active {
  background: rgba(212, 175, 55, 0.1);
  transform: scale(0.98);
}

.name-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.name-text {
  font-size: 40rpx;
  color: var(--gold-primary);
  font-weight: 600;
}

.name-score {
  font-size: 26rpx;
  color: var(--gold-primary);
  background: rgba(212, 175, 55, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.name-info {
  margin-bottom: 12rpx;
}

.name-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

.name-meaning {
  background: rgba(255, 255, 255, 0.05);
  padding: 16rpx;
  border-radius: 8rpx;
}

.meaning-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.result-text {
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
