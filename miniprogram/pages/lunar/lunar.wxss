/* pages/lunar/lunar.wxss */
.section-title {
  font-size: 36rpx;
  color: var(--gold-primary);
  text-align: center;
  margin-bottom: 30rpx;
}

.info-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  color: var(--text-muted);
  font-size: 28rpx;
}

.info-value {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 500;
}

.info-value.gold {
  color: var(--gold-primary);
}

.bazi-display {
  padding: 20rpx 0;
}

.bazi-pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0.05) 100%);
  border: 1rpx solid var(--border-gold);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  min-width: 120rpx;
}

.bazi-pillar .gan {
  font-size: 52rpx;
  color: var(--gold-primary);
  font-weight: 600;
}

.bazi-pillar .zhi {
  font-size: 52rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.bazi-pillar .label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}
