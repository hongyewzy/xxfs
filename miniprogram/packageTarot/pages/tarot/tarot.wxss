/* pages/tarot/tarot.wxss */
.input-area {
  width: 100%;
  min-height: 150rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--border-gold);
  border-radius: 12rpx;
  padding: 24rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  box-sizing: border-box;
}

.spread-list {
  display: flex;
  gap: 20rpx;
}

.spread-item {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--border-gold);
  border-radius: 12rpx;
  text-align: center;
  transition: all 0.3s;
}

.spread-item.active {
  background: rgba(212, 175, 55, 0.15);
  border-color: var(--gold-primary);
}

.spread-name {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.spread-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.tarot-cards {
  gap: 30rpx;
  padding: 30rpx 0;
}

.tarot-card-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.3s ease;
}

.tarot-card-wrapper:hover {
  transform: translateY(-8rpx);
}

.tarot-card {
  width: 180rpx;
  height: 280rpx;
  perspective: 1000rpx;
  position: relative;
  animation: fadeInUp 0.5s ease forwards;
  opacity: 0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tarot-card-front,
.tarot-card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.6s;
}

.tarot-card-front {
  background: linear-gradient(145deg, #ffffff 0%, #f8f8f8 100%);
  transform: rotateY(180deg);
  box-shadow: 0 8rpx 24rpx rgba(184, 150, 46, 0.2);
  border: 3rpx solid #b8962e;
  position: relative;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 13rpx;
}

.card-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  padding: 40rpx 20rpx 20rpx;
  border-radius: 0 0 13rpx 13rpx;
}

.tarot-card-front::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(184, 150, 46, 0.1) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.tarot-card.flipped .tarot-card-front::after {
  opacity: 1;
}

.card-symbol {
  font-size: 60rpx;
  color: #b8962e;
  text-shadow: 0 4rpx 8rpx rgba(184, 150, 46, 0.3);
}

.tarot-card-back::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border: 2rpx solid rgba(184, 150, 46, 0.3);
  border-radius: 8rpx;
  pointer-events: none;
}

.tarot-card-front::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 2rpx solid rgba(184, 150, 46, 0.2);
  border-radius: 6rpx;
  pointer-events: none;
}

.tarot-card:hover .tarot-card-back,
.tarot-card:active .tarot-card-back {
  transform: scale(1.02);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.tarot-card.flipped .tarot-card-back {
  transform: rotateY(180deg);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.tarot-card.flipped .tarot-card-front {
  transform: rotateY(0deg);
  box-shadow: 0 12rpx 32rpx rgba(184, 150, 46, 0.3);
}

.card-name {
  font-size: 28rpx;
  color: #ffffff;
  text-align: center;
  padding: 0 16rpx;
  font-weight: 600;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
}

.card-position.reversed {
  color: #ff6b6b;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
}

.card-position.upright {
  color: #51cf66;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
}

.card-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 16rpx;
}

.result-text {
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
