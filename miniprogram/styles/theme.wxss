/* ===================== 通用卡片基础样式 ===================== */

/* 基础卡片容器 - 所有页面通用 */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(184, 150, 46, 0.12);
  position: relative;
}

/* 卡片标题 */
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2A2A2A;
  padding: 36rpx 36rpx 20rpx;
}

/* ===================== 折叠卡片样式 ===================== */

/* 折叠卡片容器 - 杂志风 */
.analysis-card {
  background: #ffffff;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

/* 顶部彩色渐变装饰条 */
.analysis-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg,
    var(--gold-dark) 0%,
    var(--gold-primary) 30%,
    var(--gold-light) 60%,
    var(--gold-primary) 100%
  );
}

/* 卡片头部 */
.analysis-card .card-header {
  display: flex;
  align-items: flex-start;
  padding: 40rpx 40rpx 32rpx;
  position: relative;
  cursor: pointer;
}

.analysis-card .card-header:active {
  background: rgba(184, 150, 46, 0.03);
}

/* 展开时的底部边框 */
.analysis-card .card-header.expanded {
  border-bottom: 1rpx solid rgba(184, 150, 46, 0.12);
}

/* 卡片图标 - 圆形彩色 */
.analysis-card .card-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-dark) 100%);
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(184, 150, 46, 0.4);
}

/* 卡片标题 */
.analysis-card .card-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.analysis-card .card-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: 3rpx;
  line-height: 1.3;
}

/* 卡片标题下方的英文副标题（可选） */
.analysis-card .card-subtitle {
  font-size: 22rpx;
  color: #888;
  letter-spacing: 2rpx;
  margin-top: 6rpx;
  text-transform: uppercase;
}

/* 摘要文字 */
.analysis-card .card-summary {
  font-size: 32rpx;
  color: #5a5a6a;
  line-height: 2.2;
  padding: 0 40rpx 40rpx;
  background: transparent;
  letter-spacing: 1rpx;
}

.analysis-card .card-summary.hidden {
  display: none;
}

/* 展开/收起箭头 - 金色 */
.analysis-card .card-arrow {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold-primary);
  font-size: 24rpx;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.analysis-card .card-arrow.expanded {
  transform: rotate(180deg);
}

/* 卡片内容区域 */
.analysis-card .card-content {
  padding: 0 40rpx 48rpx;
  background: transparent;
}

/* 卡片内容隐藏 */
.analysis-card .card-content.hidden {
  display: none;
}

/* 卡片内文字内容 - 杂志风排版 */
.analysis-card .card-body {
  color: #3a3a3a;
  font-size: 32rpx;
  line-height: 2.8;
  padding: 0 40rpx 48rpx;
}

.analysis-card .card-body rich-text {
  display: block;
}

/* 段落 - 杂志风大间距 */
.analysis-card .card-body p {
  margin: 0;
  line-height: 2.8;
  color: #3a3a3a;
  padding: 32rpx 0;
  text-align: justify;
  letter-spacing: 1rpx;
  font-size: 32rpx;
}

/* 首段识别为标题 - 大字 + 底部装饰线 */
.analysis-card .card-body p:first-child {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-top: 0;
  padding-top: 32rpx;
  padding-bottom: 36rpx;
  margin-bottom: 24rpx;
  border-bottom: 6rpx solid var(--gold-primary);
  letter-spacing: 4rpx;
  line-height: 1.6;
  text-align: left;
}

/* 加粗 - 金色高亮 */
.analysis-card .card-body strong {
  font-weight: 700;
  color: var(--gold-primary);
  padding: 6rpx 16rpx;
  margin: 0 6rpx;
  background: linear-gradient(180deg, rgba(184, 150, 46, 0.18) 0%, rgba(184, 150, 46, 0.1) 100%);
  border-radius: 10rpx;
  border-bottom: 3rpx solid var(--gold-light);
  font-size: 32rpx;
}

/* 列表 */
.analysis-card .card-body ol,
.analysis-card .card-body ul {
  margin: 48rpx 0;
  padding-left: 56rpx;
}

.analysis-card .card-body ol li,
.analysis-card .card-body ul li {
  margin: 36rpx 0;
  color: #3a3a3a;
  line-height: 2.6;
  position: relative;
  padding-left: 20rpx;
  font-size: 32rpx;
}

/* 无序列表装饰圆点 - 更大更醒目 */
.analysis-card .card-body ul li::before {
  content: '';
  position: absolute;
  left: -40rpx;
  top: 32rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--gold-primary);
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(184, 150, 46, 0.5);
}

/* 有序列表数字样式 */
.analysis-card .card-body ol {
  counter-reset: item;
}

.analysis-card .card-body ol li {
  display: block;
}

.analysis-card .card-body ol li::before {
  content: counter(item) ".";
  counter-increment: item;
  position: absolute;
  left: -48rpx;
  color: var(--gold-primary);
  font-weight: 700;
  font-size: 32rpx;
}

/* 分隔线 */
.analysis-card .card-body hr {
  border: none;
  height: 6rpx;
  background: linear-gradient(90deg, transparent, var(--gold-primary), transparent);
  margin: 72rpx 0;
}

/* Markdown 标题样式 */
.analysis-card .card-body h1 {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin: 32rpx 0 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 6rpx solid var(--gold-primary);
  line-height: 1.6;
}

.analysis-card .card-body h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2a2a;
  margin: 28rpx 0 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 4rpx solid var(--gold-primary);
  line-height: 1.5;
}

.analysis-card .card-body h3 {
  font-size: 32rpx;
  font-weight: 600;
  color: #3a3a3a;
  margin: 24rpx 0 16rpx;
  line-height: 1.5;
}

/* 分析结果容器 */
.analysis-cards {
  margin-top: 30rpx;
}

/* ===================== 统一卡片样式 ===================== */

/* 基础卡片容器 */
.style-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(184, 150, 46, 0.12);
  position: relative;
}

/* 卡片顶部渐变装饰条 */
.style-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, var(--card-gradient-start), var(--card-gradient-end));
}

/* 不同颜色的装饰条变量 */
.style-card.gold { --card-gradient-start: #B8962E; --card-gradient-end: #D4A84B; }
.style-card.purple { --card-gradient-start: #8B5CF6; --card-gradient-end: #A78BFA; }
.style-card.green { --card-gradient-start: #10B981; --card-gradient-end: #34D399; }
.style-card.blue { --card-gradient-start: #3B82F6; --card-gradient-end: #60A5FA; }
.style-card.orange { --card-gradient-start: #F59E0B; --card-gradient-end: #FBBF24; }
.style-card.cyan { --card-gradient-start: #06B6D4; --card-gradient-end: #22D3EE; }
.style-card.red { --card-gradient-start: #EF4444; --card-gradient-end: #F87171; }

/* 卡片内容区 */
.style-card-content {
  padding: 36rpx;
}

/* 卡片标题 */
.style-card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2A2A2A;
  margin-bottom: 16rpx;
}

/* 卡片副标题 */
.style-card-subtitle {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

/* 卡片摘要 */
.style-card-summary {
  font-size: 30rpx;
  color: #666666;
  line-height: 2;
}

/* 卡片底部数据 */
.style-card-footer {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.style-card-footer-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999999;
}

/* ===================== 运势卡片区域样式 ===================== */

/* 运势卡片区域容器 */
.fortune-cards {
  margin-top: 32rpx;
}

/* 运势卡片区域标题 */
.fortune-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold-primary);
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}
